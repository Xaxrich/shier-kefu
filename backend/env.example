# 复制为 backend/.env 后填写真实值（密钥只放 .env，勿提交）
# 启动时由 src/core/settings.py 自动 load_dotenv

# --- 阿里云百炼（DashScope）OpenAI 兼容模式 ---
# https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
PYCORE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PYCORE_LLM_API_KEY=
PYCORE_LLM_CHAT_MODEL=qwen-turbo
PYCORE_LLM_EMBEDDING_MODEL=text-embedding-v4
